# 本机私有环境变量示例（提交前请勿填入真实值）
# 项目不会自动读取 .env 文件；这些变量需要在启动进程前 export（或在启动脚本中设置）。
# 留空 = 使用用户设置文件（~/.workbuddy/tags-market-settings.json）中的值。
# 环境变量优先于设置文件中的同名项。

# 出网代理地址（留空表示不用代理）
NAI_PROXY_URL=
# 例：NAI_PROXY_URL=http://127.0.0.1:12345

# 百度翻译凭据（通用翻译开放平台：https://fanyi-api.baidu.com/ 控制台）
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_SECRET=

# 覆盖 WorkBuddy 本机目录（默认 ~/.workbuddy，与 server/start-nai.sh 一致）。
# WORKBUDDY_HOME=

# 其他可选变量：NODE_BIN、NOVELAI_API_KEY、DANBOORU_API_KEY。
